{
    "name": "crabphp/actors",
    "description": "Actors for the Crab framework: one for each key, taking its messages one at a time and keeping its memory while it runs",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "crabphp/framework": "^0.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "carthage-software/mago": "1.57.0"
    },
    "autoload": {
        "psr-4": {
            "Crab\\Actors\\": "src/",
            "Crab\\Contracts\\Actors\\": "contracts/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Crab\\Actors\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "format": "@php vendor/bin/mago fmt",
        "format:check": "@php vendor/bin/mago fmt --check",
        "lint": "@php vendor/bin/mago lint"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../framework",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true
}
